# URL del proyecto de Supabase (Project Settings > API). Se usa en el cliente y en el servidor.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica "anon" de Supabase (Project Settings > API). Segura para exponer en el cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" de Supabase (Project Settings > API). Solo para uso en el servidor: nunca exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Conexion de Postgres que usa la app en runtime. Distinta segun el entorno,
# a proposito (no es un parche, ver CLAUDE.md > Acceso a datos) -- y desde
# la separacion dev/produccion, distinta tambien porque apunta a un
# PROYECTO de Supabase distinto, no solo a un puerto distinto del mismo
# proyecto (ver CLAUDE.md > "Separacion dev/produccion"):
#
# - En Vercel (produccion y preview): proyecto de PRODUCCION, transaction
#   pooler, puerto 6543 (Project Settings > Database > Connection string).
#   Es lo que recomienda Supabase para serverless: muchas instancias
#   efimeras, cada una con pocas conexiones propias, multiplexadas por el
#   pooler. Medido contra produccion real: ~3ms p50 por round-trip desde
#   iad1 (ver CLAUDE.md > Acceso a datos).
# - En desarrollo local: proyecto de DESARROLLO, session pooler, puerto
#   5432. El dev server es UN proceso persistente, no muchas instancias
#   efimeras -- el caso para el que Supabase recomienda el pooler de sesion
#   (o conexion directa), no el de transacciones. La conexion DIRECTA
#   (db.<ref>.supabase.co) puede no resolver en redes sin salida IPv6 --
#   si pasa, usar el pooler de sesion (mismo host regional que el pooler de
#   transacciones, puerto 5432 en vez de 6543) es la alternativa que anda.
#
# src/db/index.ts usa { prepare: false } siempre, compatible con los dos
# poolers, asi que el codigo no cambia entre entornos, solo el valor de esta
# variable.
#
# Atencion: el pooler de transacciones NO soporta prepared statements (por
# eso { prepare: false } es obligatorio si se conecta por 6543); si se
# cambia el driver o el cliente, hay que mantener eso o las queries fallan
# de forma intermitente y dificil de diagnosticar.
DATABASE_URL=

# Conexion de Postgres que usa drizzle-kit para migraciones (Project Settings >
# Database > Connection string > Session pooler, puerto 5432). Las migraciones
# necesitan sentencias (DDL, transacciones multi-statement) que el pooler de
# transacciones no soporta, por eso usan una conexion distinta a DATABASE_URL.
#
# Vive en .env.local (proyecto de DESARROLLO) para el comando de todos los
# dias (`db:migrate`, `db:generate`, `db:studio`, via drizzle.config.ts).
# Tocar produccion con drizzle-kit es un comando APARTE y deliberado
# (`db:migrate:prod`, `db:studio:prod`), que lee este mismo nombre de
# variable pero desde `.env.production-secrets.local`
# (drizzle.config.production.ts) -- un archivo `.env` distinto, no una
# variable distinta, a proposito: ver CLAUDE.md > "Separacion
# dev/produccion" para el criterio completo.
#
# El nombre NO es ".env.production.local" a proposito -- ese nombre es una
# convencion que Next.js reconoce solo (`.env.$(NODE_ENV).local`) y carga
# el solo en cualquier comando que no sea "next dev", incluido "next
# build"/"next start" corridos en esta misma maquina para otra cosa. Ver el
# incidente documentado en CLAUDE.md > Separacion dev/produccion.
MIGRATION_DATABASE_URL=

# URL publica base de la aplicacion (ej: https://consofy.com.ar o http://localhost:3000 en desarrollo).
NEXT_PUBLIC_APP_URL=

# Proveedor de mensajeria del flujo de SALIDA (comunicados masivos, etapa 8 --
# no el handoff del vecino de la etapa 5, que no usa esta variable). Valores
# validos HOY (paso 8.1): console | manual_link. Default si se deja vacio:
# console (no abre nada real, solo imprime en la terminal -- seguro para
# cualquier checkout nuevo). "cloud_api" todavia no existe (etapa 13) -- no
# lo pongas aca, la variable rechaza ese valor a proposito hasta que exista
# una implementacion real.
MESSAGING_PROVIDER=

# API key de Resend (paso 9.5) -- envío de emails al administrador (resumen
# diario, alerta de reclamo urgente). Cuenta y key se crean a mano en
# resend.com (mismo criterio que las cuentas de la etapa 0), nunca por
# script. Requerida: sin esta variable la app no arranca (ver src/lib/env.ts).
RESEND_API_KEY=

# Secreto compartido que protege /api/cron/daily (paso 9.6) -- el workflow
# de GitHub Actions lo manda como "Authorization: Bearer <valor>". Generar
# un valor al azar (ej. openssl rand -hex 32) y cargarlo ACÁ, como secret
# del repositorio en GitHub (Settings > Secrets and variables > Actions,
# mismo nombre CRON_SECRET) y como variable de entorno en Vercel -- los
# tres tienen que tener el MISMO valor. Requerida: sin esta variable la
# app no arranca (ver src/lib/env.ts).
CRON_SECRET=

# API key de la API de embeddings de Gemini (paso 14.2) -- detección de
# reclamos duplicados por similitud semantica. Modelo gemini-embedding-001,
# 768 dimensiones. Se crea a mano en Google AI Studio (aistudio.google.com),
# nunca por script. El proyecto de Google Cloud detras de esta key tiene
# facturacion con credito prepago habilitada: da limites de cuota mas altos
# que el nivel 100% gratuito, y el costo para el volumen del proyecto es
# insignificante (a ~US$0,15 / millon de tokens). Requerida: sin esta
# variable la app no arranca (ver src/lib/env.ts). Ver CLAUDE.md >
# Deteccion de duplicados por embeddings.
GEMINI_API_KEY=
